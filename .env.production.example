# =================================
# N8N Production Environment Config
# =================================

# ---------------------------------
# Database Configuration
# ---------------------------------
POSTGRES_USER=n8n
POSTGRES_PASSWORD=ChangeThisToAStrongPassword123!
POSTGRES_DB=n8n

# ---------------------------------
# N8N Application Settings
# ---------------------------------
# Version to build (optional, defaults to package.json version)
N8N_VERSION=1.118.0

# Port for N8N (usually 5678)
N8N_PORT=5678

# Protocol (http or https) - Use https in production
N8N_PROTOCOL=https

# Your domain name (e.g., n8n.yourdomain.com)
N8N_HOST=your-domain.com

# Full editor URL
N8N_EDITOR_BASE_URL=https://your-domain.com

# Webhook URL (usually same as editor URL)
WEBHOOK_URL=https://your-domain.com

# ---------------------------------
# Security (IMPORTANT!)
# ---------------------------------
# Generate with: openssl rand -hex 32
N8N_ENCRYPTION_KEY=GENERATE_A_RANDOM_KEY_HERE

# Generate with: openssl rand -hex 32
N8N_USER_MANAGEMENT_JWT_SECRET=GENERATE_ANOTHER_RANDOM_KEY_HERE

# ---------------------------------
# Email / SMTP Configuration
# ---------------------------------
N8N_EMAIL_MODE=smtp
N8N_SMTP_HOST=smtp.gmail.com
N8N_SMTP_PORT=587
N8N_SMTP_USER=your-email@gmail.com
N8N_SMTP_PASS=your-app-password
N8N_SMTP_SENDER=your-email@gmail.com
N8N_SMTP_SSL=false

# ---------------------------------
# Timezone
# ---------------------------------
TIMEZONE=Asia/Tehran

# ---------------------------------
# Logging
# ---------------------------------
N8N_LOG_LEVEL=info
N8N_LOG_OUTPUT=console

# ---------------------------------
# Performance
# ---------------------------------
# Max payload size in MB
N8N_PAYLOAD_SIZE_MAX=16
